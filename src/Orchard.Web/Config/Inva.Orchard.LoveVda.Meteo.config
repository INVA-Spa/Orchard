      <!-- URL base della REST API del Centro Funzionale Regione VdA -->
      <add key="apiBaseUrl" value="https://cf.regione.vda.it" />

      <!-- Token di autenticazione (statico - sostituire con il token assegnato da CF) -->
      <!-- TODO: spostare in un secret manager o variabile d'ambiente in produzione -->
      <add key="apiToken" value="IL_TUO_TOKEN_QUI" />

      <!-- Nome della localita per il widget mappa (ricerca case-insensitive per location_name) -->
      <add key="nomeLocalitaWidget" value="Aosta" />

      <!-- URL base per le immagini meteo (icone/mappe PNG servite da CF) -->
      <!-- Da confermare con CF: come vengono costruiti gli URL a partire dall'idx numerico -->
