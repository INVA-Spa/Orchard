      <!-- URL della pagina meteo completa sul sito LoveVda, per lingua -->
      <add key="urlLinkMeteoLovevda_it" value="https://www.lovevda.it/it/meteo" />
      <add key="urlLinkMeteoLovevda_fr" value="https://www.lovevda.it/fr/meteo" />
      <add key="urlLinkMeteoLovevda_en" value="https://www.lovevda.it/en/weather" />

      <!-- Destinatario mail per notifiche di errore -->
      <add key="destinatariMail" value="webmaster@example.com" />

      
